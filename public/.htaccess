# Postal 98 Cafe — Apache config for the built site (dist/ is the document root).

# SPA fallback: serve index.html for client-side routes (/menu, /our-story,
# /contact, /apply) so a direct visit or refresh works. Real files and /api are left alone.
RewriteEngine On
RewriteBase /
RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_URI} ^/api/ [NC]
RewriteRule ^ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]

# If the contact API runs as a plain Node process (not a cPanel "Node.js App"
# mounted on /api), uncomment to proxy to it. Requires mod_proxy + mod_proxy_http.
# RewriteRule ^api/(.*)$ http://127.0.0.1:8787/api/$1 [P,L]

# Image formats served through <picture> (src/components/Picture.tsx); cPanel's
# default mime.types may not know the newer ones.
AddType image/jxl .jxl
AddType image/avif .avif
AddType image/webp .webp

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  <FilesMatch "\.(js|css|jxl|avif|webp|jpg|jpeg|png|mp4|ttf|pdf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
